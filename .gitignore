# ==========================================
# ROS2 colcon 빌드 산출물
# ==========================================
# colcon build 를 돌릴 때마다 새로 쌓이고, 소스와 갈라진 사본이라
# 커밋되면 diff 만 채우고 재빌드 때마다 충돌합니다.
# ROS2 는 install/ 을 읽어 실행하므로 디스크에는 그대로 남겨둡니다.
ROS2_자율주행_및_연동(이다은)/build/
ROS2_자율주행_및_연동(이다은)/install/
ROS2_자율주행_및_연동(이다은)/log/

# 루트에서 colcon build 를 돌렸을 때 생기는 산출물. 위와 같은 이유로 무시하며,
# 특히 log/**/*.env 에 빌드한 PC의 실제 홈 디렉터리 경로가 그대로 남아
# 공개 저장소에는 부적절합니다.
/build/
/install/
/log/

# ==========================================
# 스테레오 캘리브레이션 촬영본
# ==========================================
# stereo_calibrate.py capture 가 만드는 체스보드 사진들. 한 번 계산해서
# stereo_calibration.npz 를 뽑고 나면 쓸 일이 없는데 용량만 큽니다.
# 결과 파일(.npz)은 1KB 남짓이고 이 로봇의 카메라 실측값이므로 커밋합니다 —
# 카메라를 바꾸면 stereo_calibrate.py verify 로 다시 확인하세요.
calib_shots/

# ==========================================
# Piper TTS 음성 모델
# ==========================================
# ko_KR-kss-medium.onnx 는 63MB 라 저장소에 넣지 않습니다.
# 젯슨에서 "TTS Engine and pipeline/setup_tts.sh" 로 받으세요.
# (.onnx.json 은 5KB 라 함께 무시해도 되지만, 둘은 항상 짝이어야 하므로
#  한쪽만 커밋되는 일이 없게 같이 막습니다.)
*.onnx
*.onnx.json
