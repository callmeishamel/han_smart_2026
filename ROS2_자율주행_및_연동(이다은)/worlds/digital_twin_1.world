<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="digital_twin_1">
    <!-- Gazebo 모델 좌표를 ROS2 /gazebo/model_states 로 발행한다.
         event_detector.py의 mock 화재/안전모 위반 판정이 이 토픽을 사용한다. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>
    <!-- Scene settings -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Boundary Walls -->
    <model name="wall_n">
      <pose>5 7.5 1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_s">
      <pose>5 -0.5 1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_w">
      <pose>-1 3.5 1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 8.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>
    <model name="wall_e">
      <pose>11 3.5 1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 8.2 2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>

    <!-- 6 Factory Racks / Obstacles -->
    <model name="rack_1">
      <pose>2 2 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1.5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1.5 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="rack_2">
      <pose>2 5 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1.5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1.5 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="rack_3">
      <pose>5 2 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1.5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1.5 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="rack_4">
      <pose>5 5 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1.5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1.5 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="rack_5">
      <pose>8 2 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1.5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1.5 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="rack_6">
      <pose>8 5 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1.5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1.5 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- 순찰 시작점에서 카메라에 보이는 mock 안전 이벤트.
         지도 생성기는 event_target 이름을 제외하므로 Nav2 정적 지도와는 분리된다. -->
    <model name="fire_event_target">
      <pose>2.7 3.5 0.5 0 0 0</pose>
      <static>true</static>
      <include><uri>model://fire_event</uri></include>
    </model>

    <model name="helmet_violation_event_target">
      <pose>3.2 2.7 0.0 0 0 0</pose>
      <static>true</static>
      <include><uri>model://helmet_violation_event</uri></include>
    </model>

    <!-- Setup Robot start pose logic is handled by spawn_entity.py but define view -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>5 -5 10 0 0.8 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
