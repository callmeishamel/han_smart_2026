<?xml version="1.0"?>
<sdf version="1.6">
  <model name="worker_with_helmet">
    <static>true</static>
    <link name="worker">
      <!-- Blue body + yellow hard hat: normal worker. -->
      <visual name="torso">
        <pose>0 0 1.05 0 0 0</pose>
        <geometry><box><size>0.42 0.25 0.65</size></box></geometry>
        <material><ambient>0.03 0.45 0.75 1</ambient><diffuse>0.03 0.45 0.75 1</diffuse></material>
      </visual>
      <visual name="head">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><sphere><radius>0.17</radius></sphere></geometry>
        <material><ambient>0.86 0.62 0.46 1</ambient><diffuse>0.86 0.62 0.46 1</diffuse></material>
      </visual>
      <visual name="helmet_crown">
        <pose>0 0 1.64 0 0 0</pose>
        <geometry><sphere><radius>0.19</radius></sphere></geometry>
        <material><ambient>1 0.65 0.02 1</ambient><diffuse>1 0.65 0.02 1</diffuse></material>
      </visual>
      <visual name="helmet_brim">
        <pose>0 0 1.57 0 0 0</pose>
        <geometry><cylinder><radius>0.24</radius><length>0.045</length></cylinder></geometry>
        <material><ambient>1 0.65 0.02 1</ambient><diffuse>1 0.65 0.02 1</diffuse></material>
      </visual>
      <visual name="left_leg">
        <pose>-0.12 0 0.42 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.8</length></cylinder></geometry>
        <material><ambient>0.1 0.12 0.18 1</ambient><diffuse>0.1 0.12 0.18 1</diffuse></material>
      </visual>
      <visual name="right_leg">
        <pose>0.12 0 0.42 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.8</length></cylinder></geometry>
        <material><ambient>0.1 0.12 0.18 1</ambient><diffuse>0.1 0.12 0.18 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
