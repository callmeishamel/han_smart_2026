# 이 파일은 예시(템플릿)입니다. 실제 비밀번호가 들어있지 않으므로 깃허브에 커밋해도 안전합니다.
#
# 사용법:
#   1. 이 파일을 같은 폴더에 "secrets.toml" 이라는 이름으로 복사하세요.
#      (복사한 secrets.toml은 .gitignore에 등록되어 있어 자동으로 커밋 대상에서 제외됩니다.)
#   2. 아래 값들을 실제 PostgreSQL 접속 정보로 바꾸세요.

db_user = "postgres"
db_password = "여기에_실제_비밀번호_입력"
db_host = "localhost"
db_port = "5432"
db_name = "smart_factory_db"
